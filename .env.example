# Elektroakademie - vzor konfigurace prostředí
# Tento soubor je bezpečné commitovat. Neobsahuje skutečné secrets.
# Skutečné hodnoty patří do .env nebo do produkčního env souboru mimo Git.

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
SITE_URL=http://127.0.0.1:8000

# E-mailový transport
# preview = nic se skutečně neodesílá
# smtp    = skutečné SMTP odesílání
EMAIL_TRANSPORT=preview

# SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=
EMAIL_TIMEOUT=20

# Odesílací adresy podle typu zprávy
EMAIL_FROM_ACTIVATION=aktivace@example.cz
EMAIL_FROM_INVOICES=faktury@example.cz
EMAIL_FROM_CERTIFICATES=osvedceni@example.cz

# Volitelné: společná adresa pro odpovědi uživatelů
EMAIL_REPLY_TO=
